TRACKABI_ENABLED=false
TRACKABI_PROVIDER=mindcloud
TRACKABI_API_BASE_URL=https://connect.mindcloud.co/v1/universal/trackabi/latest
TRACKABI_API_TOKEN=
MINDCLOUD_API_KEY=
TRACKABI_CONNECTION_ID=
TRACKABI_LIST_TIME_ENTRIES_PATH=/actions/list-time-entries
TRACKABI_AUTH_SCHEME=bearer
TRACKABI_AUTH_HEADER=Authorization
TRACKABI_CONNECTION_ID_LOCATION=query
TRACKABI_CONNECTION_ID_HEADER=X-Connection-Id
TRACKABI_DEFAULT_PROJECT_NAME=Palmetto
TRACKABI_PALMETTO_PROJECT_ID=75415
TRACKABI_FILTER_BY_PROJECT_ID=false
TRACKABI_ESTIMATE_REAL_TIME=false
TRACKABI_ESTIMATED_LOSS_MAX_MINUTES=15
TRACKABI_CREDITED_BREAK_MINUTES=75
TRACKABI_HISTORICAL_LOSS_PERIOD_IDS=5,6,7
TRACKABI_IMPORT_FROM_DATE=
TRACKABI_IMPORT_TO_DATE=
TRACKABI_FILTER_DATES_LOCALLY=true
TRACKABI_IMPORT_LIMIT=100
TRACKABI_IMPORT_MAX_PAGES=100
TRACKABI_CONFLICT_STRATEGY=manual_review_on_overlap
TRACKABI_PRODUCTIVITY_ADJUSTMENT_ENABLED=false
TRACKABI_SLACK_ADJUSTMENT_ENABLED=false
TRACKABI_MIN_ACTIVITY_SCORE_FOR_FULL_CREDIT=70
TRACKABI_MIN_ACTIVITY_SCORE_FOR_REVIEW=40
